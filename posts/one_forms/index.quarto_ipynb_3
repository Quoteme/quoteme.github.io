        "#| echo: false\n",
        "#| label: tbl-initial-visualization\n",
        "#| tbl-cap: Derivative visualized\n",
        "# Example using Python and matplotlib\n",
        "import matplotlib.pyplot as plt\n",
        "import matplotlib.patches as mpatches\n",
        "import numpy as np\n",
        "f = lambda x: np.sin(x) + 1\n",
        "x = np.linspace(0, 0.7*np.pi, 100)\n",
        "y = f(x)\n",
        "plt.plot(x, y)\n",
        "x0 = 0.1*np.pi\n",
        "l = 0.7\n",
        "plt.text(\n",
        "  x0,\n",
        "  0.05,\n",
        "  \"$x_0$\",\n",
        "  ha=\"center\",\n",
        "  va=\"bottom\"\n",
        ")\n",
        "plt.grid(True, linestyle='--')\n",
        "plt.plot(x0, 0, 'bo', markersize=8)\n",
        "plt.gca().arrow(x0, 0, l, 0, width=0.05, head_width=0.1, fc=\"black\", length_includes_head=True)\n",
        "plt.text(\n",
        "  x0+l/2,\n",
        "  0.05,\n",
        "  \"$dx|_{x_0}$\",\n",
        "  ha=\"center\",\n",
        "  va=\"bottom\"\n",
        ")\n",
        "plt.gca().arrow(x0, f(x0), l, 0, width=0.05, head_width=0.1, fc=\"black\", alpha=0.2, length_includes_head=True)\n",
        "plt.gca().arrow(x0+l, f(x0), 0, f(x0+l)-f(x0), width=0.05, head_width=0.1, fc=\"red\", length_includes_head=True)\n",
        "plt.text(\n",
        "  x0+l+0.05,\n",
        "  f(x0) + (f(x0+l) - f(x0))/2,\n",
        "  \"$df|_{x_0}$\",\n",
        "  ha=\"left\",\n",
        "  va=\"center\"\n",
        ")\n",
        "plt.show()"
