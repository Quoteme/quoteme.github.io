        "                 sdf_torus_rotated(pp, torus_cx_R, torus_R, torus_r))\n",
        "        dm = min(sdf_torus_rotated(pm, torus_cx_L, torus_R, torus_r),\n",
        "                 sdf_torus_rotated(pm, torus_cx_R, torus_R, torus_r))\n",
        "        n[i] = dp - dm\n",
        "    length = np.sqrt(n[0]**2 + n[1]**2 + n[2]**2)\n",
        "    if length > 0:\n",
        "        for i in range(3):\n",
