        "                 min(sdf_torus_rotated(pp, cx_R, torus_R, torus_r),\n",
        "                     min(sdf_rope_seg(pp, seg1, n1, rope_r, cx_L, -1),\n",
        "                         min(sdf_rope_seg(pp, seg2, n2, rope_r, cx_R, 1),\n",
        "                             sdf_plane_slab(pp, plane_x, plane_ht,\n",
