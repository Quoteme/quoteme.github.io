        "    \"vulnerability\", \"exploit\", \"cve\", \"backdoor\", \"leak\",\n",
        "]\n",
        "PAT = re.compile(r\"(?<!\\w)(\" + \"|\".join(SENSITIVE) + r\")(?!\\w)\", re.IGNORECASE)\n",
        "\n",
        "# ── 1. Commit messages ────────────────────────────────────────────────────────\n",
