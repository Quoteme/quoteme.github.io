        "        diff_hits.append((c.hexsha[:7], c.committed_datetime.strftime(\"%Y-%m-%d\"), snippets))\n",
        "\n",
        "# ── Render results ────────────────────────────────────────────────────────────\n",
        "def kw(words):\n",
