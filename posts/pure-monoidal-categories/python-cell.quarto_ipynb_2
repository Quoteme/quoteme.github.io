        "#| label: fig-player\n",
        "#| fig-cap: Marginal distributions of bill dimensions\n",
        "\n",
        "from dataclasses import dataclass\n",
        "\n",
        "@dataclass\n",
        "class Player:\n",
        "  x: float\n",
        "  y: float\n",
        "  dx: float\n",
        "  dy: float\n",
        "\n",
        "  def update(self) -> None:\n",
        "    self.x += self.dx\n",
        "    self.y += self.dy\n",
        "\n",
        "def main() -> None:\n",
        "  # create a new Player\n",
        "  player = Player(x=0.0, y=0.0, dx=1.0, dy=1.0)\n",
        "  player.update() # <- impure mutation of state \"player\"!"
