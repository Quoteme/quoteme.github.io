        "#| echo: false\n",
        "import numpy as np\n",
        "import plotly.graph_objects as go\n",
        "\n",
        "words = {\n",
        "    \"dog\":     np.array([-2,  1, -1], dtype=float),\n",
        "    \"walk\":    np.array([-2,  1,  1], dtype=float),\n",
        "    \"park\":    np.array([-2, -1,  1], dtype=float),\n",
        "    \"car\":     np.array([ 2,  1, -1], dtype=float),\n",
        "    \"drive\":   np.array([ 2,  1,  1], dtype=float),\n",
        "    \"highway\": np.array([ 2, -1,  1], dtype=float),\n",
        "}\n",
        "\n",
        "edges = [\n",
        "    (\"dog\",  \"walk\",    \"#a0c4ff\"),\n",
        "    (\"dog\",  \"car\",     \"#ff4d4d\"),\n",
        "    (\"walk\", \"park\",    \"#a0c4ff\"),\n",
        "    (\"walk\", \"drive\",   \"#ff4d4d\"),\n",
        "    (\"park\", \"highway\", \"#ff4d4d\"),\n",
        "    (\"car\",  \"drive\",   \"#a0c4ff\"),\n",
        "    (\"drive\",\"highway\", \"#a0c4ff\"),\n",
        "]\n",
        "\n",
        "# ---- scatter for the word nodes ----\n",
        "xs, ys, zs = zip(*[words[w] for w in words])\n",
        "labels = list(words.keys())\n",
        "\n",
        "node_trace = go.Scatter3d(\n",
        "    x=xs, y=ys, z=zs,\n",
        "    mode=\"markers+text\",\n",
        "    text=labels,\n",
        "    textposition=\"top center\",\n",
        "    textfont=dict(size=14, color=\"#1a1a2e\"),\n",
        "    marker=dict(size=6, color=\"#4c8cbf\", opacity=0.9),\n",
        "    hoverinfo=\"skip\",\n",
        ")\n",
        "\n",
        "# ---- line + cone for each directed edge ----\n",
        "line_traces = []\n",
        "cone_traces = []\n",
        "for src, dst, color in edges:\n",
        "    s = words[src]\n",
        "    d = words[dst]\n",
        "    direction = d - s\n",
        "    # place cone 90% of the way along the edge so it sits near the arrowhead\n",
        "    cone_pos = s + 0.85 * direction\n",
        "\n",
        "    line_traces.append(go.Scatter3d(\n",
        "        x=[s[0], d[0]], y=[s[1], d[1]], z=[s[2], d[2]],\n",
        "        mode=\"lines\",\n",
        "        line=dict(color=color, width=3),\n",
        "        hoverinfo=\"none\",\n",
        "        showlegend=False,\n",
        "    ))\n",
        "    cone_traces.append(go.Cone(\n",
        "        x=[cone_pos[0]], y=[cone_pos[1]], z=[cone_pos[2]],\n",
        "        u=[direction[0]], v=[direction[1]], w=[direction[2]],\n",
        "        sizemode=\"absolute\",\n",
        "        sizeref=0.25,\n",
        "        anchor=\"tail\",\n",
        "        colorscale=[[0, color], [1, color]],\n",
        "        showscale=False,\n",
        "        hoverinfo=\"none\",\n",
        "    ))\n",
        "\n",
        "fig = go.Figure(data=line_traces + cone_traces + [node_trace])\n",
        "fig.update_layout(\n",
        "    scene=dict(\n",
        "        xaxis=dict(title=\"x\", showbackground=False, showgrid=True, zeroline=False),\n",
        "        yaxis=dict(title=\"y\", showbackground=False, showgrid=True, zeroline=False),\n",
        "        zaxis=dict(title=\"z\", showbackground=False, showgrid=True, zeroline=False),\n",
        "        bgcolor=\"rgba(0,0,0,0)\",\n",
        "    ),\n",
        "    paper_bgcolor=\"rgba(0,0,0,0)\",\n",
        "    plot_bgcolor=\"rgba(0,0,0,0)\",\n",
        "    margin=dict(l=0, r=0, t=30, b=0),\n",
        "    height=520,\n",
        "    showlegend=False,\n",
        ")\n",
        "fig.show()"
      ],
